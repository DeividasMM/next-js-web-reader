# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (libSQL / Turso) ---
# Leave empty for local development: the app then uses file:.data/local.db,
# created by `npm run db:migrate` (which `npm run dev` runs automatically).
# For a Turso database: `turso db show <name> --url` and `turso db tokens create <name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Clerk authentication ---
# Optional in development: without keys Clerk runs in "keyless" mode and prints a
# link to claim a temporary dev instance. Required for production builds.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
